{
  "name": "trustforge-ai",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "mcp:stdio": "tsx mcp/stdio.ts",
    "mcp:http": "tsx mcp/http.ts",
    "mcp:build": "esbuild mcp/http.ts mcp/stdio.ts --bundle --platform=node --format=esm --outdir=dist/mcp --packages=external",
    "mcp:smoke": "node scripts/smoke-mcp.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.23",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@trpc/server": "^11.7.2",
    "better-auth": "^1.6.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "next": "16.3.0-canary.21",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.0-canary.21",
    "js-yaml": "^4.3.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
