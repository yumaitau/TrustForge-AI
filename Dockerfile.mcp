FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN npm run mcp:build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production MCP_HOST=0.0.0.0 MCP_PORT=3100
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 trustforge
COPY package.json package-lock.json .npmrc ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=builder --chown=trustforge:nodejs /app/dist/mcp ./dist/mcp
USER trustforge
EXPOSE 3100
CMD ["node", "dist/mcp/http.js"]
