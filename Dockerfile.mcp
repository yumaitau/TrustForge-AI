FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci

FROM oven/bun:1.4-alpine AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN bun build mcp/http.ts mcp/stdio.ts --outdir=dist/mcp --target=bun

FROM oven/bun:1.4-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production MCP_HOST=0.0.0.0 MCP_PORT=3100
COPY --from=builder --chown=bun:bun /app/dist/mcp ./dist/mcp
USER bun
EXPOSE 3100
CMD ["bun", "--bun", "dist/mcp/http.js"]
